{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "paths": {
      "@intermenu/aiuic-core": [
        "../../packages/core/src/index.ts"
      ],
      "@intermenu/aiuic-resolve": [
        "../../packages/resolve/src/index.ts"
      ],
      "@intermenu/hepta": [
        "../../packages/hepta/src/index.ts"
      ],
      "@intermenu/aiuic-present": [
        "../../packages/present/src/index.ts"
      ],
      "@intermenu/aiuic-devtools": [
        "../../packages/devtools/src/index.ts"
      ],
      "@intermenu/aiuic-eui": [
        "../../packages/eui/src/index.ts"
      ],
      "@intermenu/aiuic-kit": [
        "../../packages/kit/src/index.ts"
      ],
      "@intermenu/aiuic-memory": [
        "../../packages/memory/src/index.ts"
      ],
      "@intermenu/aiuic-pyramid": [
        "../../packages/pyramid/src/index.ts"
      ],
      "@intermenu/aiuic-menu": [
        "../../packages/menu/src/index.ts"
      ],
      "@intermenu/aiuic-mcp": [
        "../../packages/mcp/src/index.ts"
      ],
      "@intermenu/aiuic-adapters": [
        "../../packages/adapters/src/index.ts"
      ],
      "@intermenu/sdk": [
        "../../packages/sdk/src/index.ts"
      ],
      "@intermenu/aiuic-notify": [
        "../../packages/notify/src/index.ts"
      ],
      "@intermenu/aiuic-settings": [
        "../../packages/settings/src/index.ts"
      ],
      "@intermenu/knowing": [
        "../../packages/knowing/src/index.ts"
      ]
    }
  },
  "include": [
    "api.ts",
    "vercel.ts",
    "server.ts"
  ]
}